{
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.deepseek.com/anthropic",
    "ANTHROPIC_AUTH_TOKEN": "<REDACTED: 见本机 ~/.claude/settings.json>",
    "ANTHROPIC_MODEL": "deepseek-v4-flash[1m]",
    "ANTHROPIC_SMALL_FAST_MODEL": "deepseek-v4-flash[1m]",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "786432"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(xcodebuild *)",
      "Bash(swift *)",
      "Bash(xcrun *)",
      "Bash(plutil *)",
      "Bash(defaults *)",
      "Bash(osascript -e 'tell application \"Google Chrome\"*)",
      "Bash(osascript *)",
      "Bash(~/.pyenv/versions/3.11.0/bin/python3 ~/Desktop/Discord自动聊天/配频道.py)",
      "Bash(ssh -i ~/.ssh/<私钥> root@<服务器IP> *)"
    ],
    "deny": [],
    "ask": []
  },
  "statusLine": {
    "type": "command",
    "command": "python3 ~/.claude/statusline.py",
    "padding": 0
  },
  "theme": "custom:dracula",
  "language": "Chinese",
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "思考中",
      "分析中",
      "推敲中",
      "梳理中",
      "查证中",
      "酝酿中",
      "推演中",
      "核对中"
    ]
  },
  "spinnerTipsOverride": {
    "excludeDefault": true,
    "tips": [
      "输入 / 查看所有命令",
      "按 Ctrl+K 打开命令面板",
      "按 Esc 可中断当前生成",
      "Shift+Tab 切换 Plan / Agent 模式",
      "输入 @ 引用文件路径",
      "Ctrl+R 恢复历史会话",
      "「思考中」按 Ctrl+O 可展开查看",
      "输入 # 可快速追加记忆"
    ]
  },
  "awaySummaryEnabled": false,
  "showThinkingSummaries": true,
  "autoUpdates": false,
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  }
}
